{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "time_matrix",
  "position": {
    "x": 24,
    "y": 404,
    "z": 0,
    "width": 1232,
    "height": 292,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "pivotTable",
    "query": {
      "queryState": {
        "Rows": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_date"
                    }
                  },
                  "Property": "month_label"
                }
              },
              "queryRef": "dim_date.month_label",
              "nativeQueryRef": "month_label"
            }
          ]
        },
        "Columns": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Time Comparison"
                    }
                  },
                  "Property": "Time Comparison"
                }
              },
              "queryRef": "Time Comparison.Time Comparison",
              "nativeQueryRef": "Time Comparison"
            }
          ]
        },
        "Values": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Total Generation kWh"
                }
              },
              "queryRef": "_Measures.Total Generation kWh",
              "nativeQueryRef": "Total Generation kWh"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true,
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Generation: current, prior month, MoM, YTD and rolling 28 days'"
                }
              }
            }
          }
        }
      ]
    }
