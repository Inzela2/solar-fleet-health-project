/// One row per alert raised by the fault detector.
table fact_alerts
	lineageTag: b6019ed5-751c-5d83-ba26-750ac33dd5f0

	column site_id
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: 19c47f95-c5bf-5a4b-91b7-185e08e83d48
		summarizeBy: none
		sourceColumn: site_id

		annotation SummarizationSetBy = Automatic

	column date
		dataType: dateTime
		formatString: dd mmm yyyy
		isHidden
		lineageTag: 72a666b0-3370-5602-b18f-9103282c4e1e
		summarizeBy: none
		sourceColumn: date

		annotation SummarizationSetBy = Automatic

	column alert_type
		dataType: string
		lineageTag: d4908658-da35-51ec-9b1b-dfc3d80130fe
		summarizeBy: none
