		sourceColumn: created_at

		annotation SummarizationSetBy = Automatic

	partition fact_alerts = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database ( PgServer, PgDatabase ),
				    Data = Source{[Schema = "reporting", Item = "fact_alerts"]}[Data]
				in
