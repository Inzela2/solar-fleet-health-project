/// One row per site per day: generation, consumption, yield and health flags.
table fact_daily
	lineageTag: 397a96e9-90d4-5130-a674-a790e8d0d10a

	column site_id
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: 54d19194-319f-5e92-bc89-55354d2ad68d
		summarizeBy: none
		sourceColumn: site_id

		annotation SummarizationSetBy = Automatic

	column date
		dataType: dateTime
		formatString: dd mmm yyyy
		isHidden
		lineageTag: 973cc023-deb4-5b4c-8c80-c090aa7d8528
		summarizeBy: none
		sourceColumn: date

		annotation SummarizationSetBy = Automatic

	column gen_kwh
